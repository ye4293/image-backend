PORT=8080
# 数据库。三种取值：
#   留空                → 临时文件 SQLite，**进程一停全没**（账号、订阅、余额都消失）
#   ./local.db 等路径   → SQLite 文件，数据持久。本机没有 Docker 时本地开发用这个
#   postgres://…        → Postgres
# 订阅联调（付款→发额度→续费→退订→重投同一事件）跨越多次重启，留空是走不完的。
# cmd/seed-stripe 也会直接拒绝在留空时运行——它要在 Stripe 建真实的 Product/Price，
# 把回填的 Price ID 写进临时库等于扔掉，重跑还会堆一批重复商品。
DATABASE_URL=./local.db
# 生产必须修改；连接真实数据库时若保持默认值服务将拒绝启动
JWT_SECRET=dev-secret-change-me

# ---- 配置加密主密钥 ----
# 加密 app_settings 表里 secret 项（上游 key、R2 密钥）的主密钥。
# **必填，缺了或长度不对会拒绝启动**——解不开的密文等于所有上游凭据失效，
# 那时起来只会以「上游认证失败」的形式误导排查。
# 生成：openssl rand -base64 32
#
# 它和数据库备份要**一起**备份。丢了它，库里的 secret 无法恢复，只能登进后台重填。
CONFIG_ENCRYPTION_KEY=

# 仅测试用：指向 Postgres 时才会运行并发扣费测试。
# 留空时该测试会 SKIP 并打印原因（SQLite 单连接会串行化并发，测不出竞争）。
# 这两条测试（TestConcurrentSpendNeverOversells、TestConcurrentRefundRefundsOnce）
# 覆盖从未在真实数据库执行的代码路径——上线前必须跑通。
TEST_DATABASE_URL=

# 启动时把该邮箱的**已存在**用户提权为管理员；该邮箱**注册时**也会被提权
# （新库场景，dev 模式只有这条路可走）。解决"第一个管理员从哪来"。
# 留空（默认）则两处都不执行。它不创建用户、不绕过登录，只认这一个邮箱。
BOOTSTRAP_ADMIN_EMAIL=

# 上游网关。代码只读环境变量、**不会自动加载本文件**，本地用：
#   set -a; . ./.env; set +a && go run ./cmd/server
#
# FLUX_API_KEY 留空时使用 stub adapter：出本地占位图，并保留 prompt 关键词触发
# （fail 800ms 失败并退款 > slow 90s > quick 200ms > 默认 15s）。
# **前端的 e2e 必须在 stub 模式下跑**——接真上游后每跑一次都真调 Flux，
# 每次 20 多秒且每次花钱（实测单张约 7 个上游单位）。
EZLINKAI_BASE_URL=https://api.ezlinkai.com
FLUX_API_KEY=

# ---- Stripe ----
# 测试用 sk_test_ 开头。live 密钥配合 localhost 的 APP_BASE_URL 会拒绝启动。
STRIPE_SECRET_KEY=
# 本地：stripe listen --forward-to localhost:8080/api/v1/webhooks/stripe 打印的值
# 生产：Dashboard → Webhooks → 对应 endpoint 的 Signing secret
# **两者是不同的值**，混用会导致验签一直失败。
STRIPE_WEBHOOK_SECRET=
# 前端地址，用于拼 Checkout 成功/取消的跳转。
APP_BASE_URL=http://localhost:3000

# ---- CORS ----
# 允许跨域直连本后端的前端来源，逗号分隔。**只支持精确匹配，不支持通配符。**
# 留空 = 中间件完全不介入（响应与没有该中间件时逐字节一致）。
#
# 只有前端与后端**不同源**时才需要（前端在 Vercel、后端在自己服务器就是这种）。
# 同源部署（nginx 同时服务前端与 /api）或前端走服务端代理时留空才是对的。
#
# 配错的表现很误导：进程照常启动、**curl 测全通**，只有浏览器里所有请求被拦掉，
# 而反代日志里只有一串被拒的 OPTIONS（403）。所以下面几种写法会**拒绝启动**：
#   · *                    —— 它能正常工作，只是把 API 对全网敞开（认证走 header
#                             不走 cookie，浏览器允许 * 与 Authorization 共存）
#   · https://*.vercel.app —— 任何含 * 的写法都拒绝，理由见下
#   · moloom.ai            —— 缺 scheme，Origin 头永远带 scheme，这项永远匹配不上
#   · https://x.com/       —— 尾斜杠，Origin 头永远不带，同上
#   · https://u@x.com      —— userinfo；https://x.com:abc —— 非法端口，同上
#
# 为什么不支持通配符（这是一次代码审查后的刻意回退，别再加回来）：
# 后缀匹配无法可靠地锚定在 DNS 标签边界上。https://*moloom.ai（比 https://*.moloom.ai
# 少一个点）会放行攻击者注册的 evilmoloom.ai；而"后缀必须含点号"这条约束会被通配符
# 自带的分隔点满足，于是 https://*.com 一路通过、等于放行整个 TLD。
#
# 注意子域**不自动继承**：配了 https://moloom.ai 不会放行 https://app.moloom.ai，
# 两个都要用就两个都列出来。端口和 scheme 不同即不同 origin，同理要分别列出。
#
# Vercel preview 若需在浏览器里直连后端，正解是用 Vercel 的 Preview Deployment
# Suffix 把预览放到自有域名下，再把那个域名逐个列进来。
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- 图片转存（Cloudflare R2）----
# 五项必须齐全，缺任何一项都退化成不转存——
# 那时 image_url 存的是上游临时链接，约一小时后失效。
# R2_PUBLIC_BASE_URL 必须是绑在桶上的自定义域，不能填 R2_ENDPOINT：
# S3 endpoint 不允许匿名读，拿它拼出来的图片 URL 每一个都会 401。
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
