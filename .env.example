PORT=8080
# 留空则使用临时文件 SQLite（dev 模式，仅本地开发）
# Postgres：内测起就应该用它。留空会退化成临时文件 SQLite，
# 进程一停账号与余额全没——测试期间反复重发次数会污染你对扣费正确性的判断。
DATABASE_URL=postgres://imageapp:imageapp@localhost:5432/imageapp?sslmode=disable
# 生产必须修改；连接真实数据库时若保持默认值服务将拒绝启动
JWT_SECRET=dev-secret-change-me

# 仅测试用：指向 Postgres 时才会运行并发扣费测试。
# 留空时该测试会 SKIP 并打印原因（SQLite 单连接会串行化并发，测不出竞争）。
# 这两条测试（TestConcurrentSpendNeverOversells、TestConcurrentRefundRefundsOnce）
# 覆盖从未在真实数据库执行的代码路径——上线前必须跑通。
TEST_DATABASE_URL=

# 启动时把该邮箱的**已存在**用户提权为管理员；该邮箱**注册时**也会被提权
# （新库场景，dev 模式只有这条路可走）。解决"第一个管理员从哪来"。
# 留空（默认）则两处都不执行。它不创建用户、不绕过登录，只认这一个邮箱。
BOOTSTRAP_ADMIN_EMAIL=

# 上游网关。代码只读环境变量、**不会自动加载本文件**，本地用：
#   set -a; . ./.env; set +a && go run ./cmd/server
#
# FLUX_API_KEY 留空时使用 stub adapter：出本地占位图，并保留 prompt 关键词触发
# （fail 800ms 失败并退款 > slow 90s > quick 200ms > 默认 15s）。
# **前端的 e2e 必须在 stub 模式下跑**——接真上游后每跑一次都真调 Flux，
# 每次 20 多秒且每次花钱（实测单张约 7 个上游单位）。
EZLINKAI_BASE_URL=https://api.ezlinkai.com
FLUX_API_KEY=
