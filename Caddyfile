# Caddy 反向代理：自动申请并续期 Let's Encrypt 证书。
#
# 选 Caddy 而不是 nginx 的实际理由：nginx 的 proxy_read_timeout 默认 60 秒，
# 而生成要挂住连接 20~30 秒、慢模型更久——这是个必须记得去改、忘了就 504
# 的坑。Caddy 的 reverse_proxy 默认不设响应超时，行为上更贴合这个场景。
# 下面仍然把超时显式写出来，因为"默认值恰好合适"是会随版本变的。

{$API_DOMAIN} {
	# 生成请求会挂 20~30 秒（慢模型按设计最长 3 分钟）。这两个值必须
	# 大于最慢的生成，否则用户会在快出图时拿到 504——而服务端其实已经
	# 扣了次数并且还在跑。
	reverse_proxy backend:8080 {
		transport http {
			# 从上游读响应的超时。这是最容易掐断生成的那个值。
			read_timeout 5m
			write_timeout 5m
			# 连接后端本身应该很快；这里短一点，连不上要快速失败而不是干等。
			dial_timeout 10s
		}
		# 把真实客户端 IP 传给后端。加限流之后要靠它区分调用方，
		# 否则所有请求在后端看来都来自 Caddy 容器的内网 IP。
		header_up X-Real-IP {remote_host}
	}

	# 压缩响应。生成接口返回的是 JSON（图片本身在 CDN 上，不经过这里）。
	encode gzip

	log {
		output stdout
		format console
	}
}
