# 生产部署环境变量。复制成 .env.prod 后逐项填写，**不要提交填好的那份**。
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ---- 域名 ----
# 后端的公网域名。Caddy 用它申请证书，Vercel 上的前端用它作为 BACKEND_URL。
# 必须先把 A 记录指向这台服务器，Caddy 才签得出证书。
API_DOMAIN=api.example.com

# ---- 数据库 ----
POSTGRES_USER=imageapp
# 换成随机强密码。库不对外暴露端口，但弱密码在容器逃逸或内网横向时仍是短板。
POSTGRES_PASSWORD=
POSTGRES_DB=imageapp

# ---- 认证 ----
# 必须换掉。后端在连接真实数据库时若发现是默认值 dev-secret-change-me 会拒绝启动。
# 生成：openssl rand -base64 48
JWT_SECRET=

# ---- 上游 ----
EZLINKAI_BASE_URL=https://api.ezlinkai.com
# 留空会退化成 stub adapter（出占位图，不调上游、不花钱）。
# 生产必须填；填错或过期时后端日志会明确打出「认证失败」而不是笼统的上游错误。
FLUX_API_KEY=

# ---- 引导第一个管理员 ----
# 用该邮箱注册后即成为管理员。库里一旦已有管理员，这个变量就自动失效，
# 所以用完不删也安全（见 README 的说明）。
BOOTSTRAP_ADMIN_EMAIL=
