# 宿主机 nginx 反代 image-backend 的示例配置。
#
# 适用场景：这台服务器上已经有 nginx 在管 80/443 与证书，不使用 compose 里的
# Caddy（那个服务已加 profiles: ["caddy"]，默认不启动）。
#
# 对应的 compose 侧配置：backend 已把端口绑到 127.0.0.1:8080，所以 nginx 用
# proxy_pass http://127.0.0.1:8080 即可；8080 不对公网开放。
#
# 放置位置（Debian/Ubuntu）：
#   /etc/nginx/sites-available/api.example.com
#   ln -s /etc/nginx/sites-available/api.example.com /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx

# ------------------------------------------------------------------
# 认证接口的限流（第二道；第一道在应用内，见 internal/middleware/ratelimit.go）。
#
# **必须放在 http 块里，不能放进 server 块**——limit_req_zone 是 http 级指令，
# 放错位置 nginx -t 会直接报 "limit_req_zone directive is not allowed here"。
# 宝塔面板的话，加到 /www/server/nginx/conf/nginx.conf 的 http { } 里。
#
# 为什么两道都要：应用内那道在容器里，依赖 TRUSTED_PROXIES 配对才能拿到真实 IP；
# nginx 这道用 $binary_remote_addr，是它自己看到的对端，不受那个配置影响。两者独立
# 生效，任一配错另一个还在。
#
# 10r/m = 每分钟 10 次，burst=5 允许小突发，nodelay 让突发不排队而是立即放行。
# 真人注册或改密码打不到这个量，脚本刷号会立刻撞上。
#
# limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=10r/m;
# ------------------------------------------------------------------

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.example.com;          # ← 换成你的后端域名

    # 证书按你现有的方式管理（certbot / acme.sh 等）
    ssl_certificate     /etc/letsencrypt/live/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;

    # ------------------------------------------------------------------
    # 这一段是**整个文件里最重要的部分**，漏了就会以最坏的方式坏掉。
    #
    # nginx 的 proxy_read_timeout 默认是 60 秒，而一次生成要挂住连接 25~35 秒、
    # 慢模型按设计最长 3 分钟（后端 upstreamTimeout = 5 分钟）。默认值之下，
    # 慢一点的生成会在**快出图的时候**给用户一个 504 —— 而服务端并不会停：
    # 它刻意用脱离请求的 context，图会照样出完、次数照样已经扣了。
    # 用户看到的是"失败了但扣了钱"，只能去 /history 里把图找回来。
    #
    # 所以这两个值必须大于最慢的一次生成。这里给 5 分钟，与后端的
    # upstreamTimeout 对齐。
    # ------------------------------------------------------------------
    proxy_read_timeout    300s;
    proxy_send_timeout    300s;
    proxy_connect_timeout 10s;

    # Stripe webhook 的验签是对**原始字节**做的。任何改写 body 的行为都会让
    # 验签失败，而表现是 webhook 一直 400、Stripe 无限重投、用户付了钱拿不到
    # 次数。所以不要在这里加任何 body 改写类模块。
    #
    # 上传/请求体上限：生成请求体只是一段 JSON，1m 足够；留大一点无害。
    client_max_body_size 2m;

    # ------------------------------------------------------------------
    # CORS 由**后端**产生（见 internal/middleware/cors.go，白名单来自
    # CORS_ALLOWED_ORIGINS）。所以这里**不要**再加 add_header 'Access-Control-*'。
    #
    # 加了会坏得很难认：两个 Access-Control-Allow-Origin 头同时出现时，浏览器
    # 判定为非法并拒绝**整个**响应，控制台里的报错却指向 CORS 配置缺失——于是
    # 排查方向被引向"后端没配 CORS"，而后端其实配对了。
    #
    # 同理不要拦 OPTIONS（别写 `if ($request_method = OPTIONS) { return 204; }`）：
    # nginx 自己回的 204 不带白名单校验，等于把跨域对全网敞开，而且绕过了后端
    # 那份唯一的来源列表。预检必须原样透传给后端。
    #
    # 排查提示：来源不在白名单时，后端对预检回 **403**（不是 404）。所以
    # "浏览器全挂、curl 全通"时，在访问日志里找 `OPTIONS ... 403`。
    # ------------------------------------------------------------------

    # 认证接口的限流。放在 location / 之前——nginx 的 location 匹配里，前缀更长的
    # 优先，所以这个块会先于 location / 命中 /api/v1/auth/ 下的请求。
    #
    # 需要先在 http 块里定义 auth_limit zone（见文件顶部那段注释）。没定义就启用
    # 这里会让 nginx -t 失败，那是好事：比静默地没有限流好。
    #
    # limit_req_status 429 而不是默认的 503：503 的语义是"服务不可用"，会让客户端
    # 与监控误判成后端挂了；429 明确表示"你太快了"，也与应用内那道保持一致。
    #
    # location /api/v1/auth/ {
    #     limit_req      zone=auth_limit burst=5 nodelay;
    #     limit_req_status 429;
    #
    #     proxy_pass http://127.0.0.1:8080;
    #     proxy_http_version 1.1;
    #     proxy_set_header Host              $host;
    #     proxy_set_header X-Real-IP         $remote_addr;
    #     proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 生成接口是同步长请求，不要让 nginx 缓冲整个响应再吐给客户端。
        proxy_buffering off;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name api.example.com;          # ← 换成你的后端域名
    return 301 https://$host$request_uri;
}
